# PostgreSQL connection string
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/financial_runway

# Google Gemini API key (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Demo login credentials (basic access gate, not real security)
APP_USERNAME=your_demo_username
APP_PASSWORD=your_demo_password
